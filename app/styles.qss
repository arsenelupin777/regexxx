QWidget { background: @background@; color: @text@; font-family: "Segoe UI"; font-size: 13px; }
QPlainTextEdit, QTreeWidget { background: @surface@; border: 1px solid @border@; border-radius: 6px; padding: 4px; font-family: Consolas, monospace; font-size: 14px; selection-background-color: @selected@; selection-color: @text@; }
QPlainTextEdit:focus, QTreeWidget:focus { border-color: @accent@; }
QLabel { padding: 2px 0; }
QLabel[section="true"] { font-weight: 600; }
QToolButton { background: @button@; border: 1px solid @border@; border-radius: 5px; padding: 5px 7px; }
QToolButton:hover { background: @hover@; }
QToolButton:checked { background: @selected@; border-color: @accent@; }
QToolButton:focus, QCheckBox:focus { border: 1px solid @accent@; }
QToolButton:disabled { color: @disabled@; background: @background@; }
QCheckBox { spacing: 4px; padding: 3px 0; }
QCheckBox::indicator { width: 13px; height: 13px; }
QHeaderView::section { background: @button@; color: @text@; padding: 6px; border: none; border-right: 1px solid @border@; font-weight: 600; }
QTreeWidget::item { padding: 3px 0; }
QTreeWidget::item:selected { background: @selected@; color: @text@; }
QSplitter::handle { background: @border@; width: 5px; height: 5px; }
QSplitter::handle:hover { background: @accent@; }
QMenu { background: @surface@; border: 1px solid @border@; padding: 4px; }
QMenu::item { padding: 6px 16px; }
QMenu::item:selected { background: @selected@; }
QMenu::item:disabled { color: @disabled@; }
QToolTip { background: @surface@; color: @text@; border: 1px solid @border@; padding: 4px; }
QDockWidget::title { padding: 6px; background: @button@; }
QScrollBar:vertical { background: @background@; width: 12px; margin: 0; }
QScrollBar:horizontal { background: @background@; height: 12px; margin: 0; }
QScrollBar::handle { background: @border@; border-radius: 4px; min-width: 24px; min-height: 24px; }
QScrollBar::handle:hover { background: @accent@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
